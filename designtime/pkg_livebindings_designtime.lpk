<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="pkg_livebindings_designtime"/>
    <Type Value="DesignTime"/>
    <Author Value="LiveBindings for Lazarus"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\runtime"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="LiveBindings Design-Time Package for Lazarus IDE (Property Editors, Component Editor, Expression Dialog and Visual Dockable Designer)"/>
    <License Value="LGPL with linking exception"/>
    <Version Major="1" Minor="0" Release="0"/>
    <Files Count="5">
      <Item1>
        <Filename Value="uLiveBindingsRegister.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uLiveBindingsRegister"/>
      </Item1>
      <Item2>
        <Filename Value="uBindingPropEditors.pas"/>
        <UnitName Value="uBindingPropEditors"/>
      </Item2>
      <Item3>
        <Filename Value="uBindingComponentEditor.pas"/>
        <UnitName Value="uBindingComponentEditor"/>
      </Item3>
      <Item4>
        <Filename Value="uBindingDesignerForm.pas"/>
        <UnitName Value="uBindingDesignerForm"/>
      </Item4>
      <Item5>
        <Filename Value="uBindingExpressionDialog.pas"/>
        <UnitName Value="uBindingExpressionDialog"/>
      </Item5>
    </Files>
    <RequiredPkgs Count="4">
      <Item1>
        <PackageName Value="pkg_livebindings_runtime"/>
      </Item1>
      <Item2>
        <PackageName Value="IDEIntf"/>
      </Item2>
      <Item3>
        <PackageName Value="LCL"/>
      </Item3>
      <Item4>
        <PackageName Value="FCL"/>
      </Item4>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
